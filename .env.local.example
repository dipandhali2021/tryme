# Decart API key — server-side only, used by /api/realtime-token to mint
# short-lived browser tokens. Get yours at https://decart.ai (dashboard → API keys).
DECART_API_KEY=

# Extra keys (optional): when a key is out of credits / rejected, the token
# route automatically falls through to the next one. Either numbered vars…
DECART_API_KEY_2=
# …or a single comma/space separated list.
DECART_API_KEYS=
